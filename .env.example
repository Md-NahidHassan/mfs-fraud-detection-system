# Pooled PostgreSQL connection from Neon or Supabase; never commit real credentials.
DATABASE_URL=
# Required on Vercel when DATABASE_URL is configured. Protects UI and API.
ANALYST_PASSWORD=
SESSION_SECRET=
# Local demo mode works automatically without a database. On Vercel explicitly
# set DEMO_MODE=true only for a public synthetic-data demonstration.
DEMO_MODE=false
